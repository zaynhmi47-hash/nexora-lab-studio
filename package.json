{
  "name": "nexora-monorepo",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "muslim": "node scripts/nexora-muslim.mjs",
    "muslim:android": "pnpm --filter nexora-muslim-mobile android",
    "muslim:web": "pnpm --filter nexora-muslim-mobile web",
    "muslim:ios": "pnpm --filter nexora-muslim-mobile ios",
    "muslim:typecheck": "pnpm --filter nexora-muslim-mobile typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
