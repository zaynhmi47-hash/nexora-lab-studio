# Nexora Finance Web
# Public values may be exposed to the browser only when prefixed with NEXT_PUBLIC_.
# Never place secrets in NEXT_PUBLIC_* variables.

# Nexora Core API
NEXT_PUBLIC_NEXORA_API_URL="http://127.0.0.1:8000"

# Firebase Web configuration (public client configuration only).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID="nexora-73cfa"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Optional client-side feature flags.
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_ENABLE_NOTIFICATIONS="false"

# Server-only integrations belong here when introduced.
# Never prefix secrets with NEXT_PUBLIC_.
