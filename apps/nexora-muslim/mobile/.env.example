# Nexora Core API
# For a physical Android device, replace localhost with your development machine's LAN IP.
EXPO_PUBLIC_NEXORA_CORE_URL=http://localhost:8000

# Select mock during local UI development; use firebase only after configuring Firebase.
EXPO_PUBLIC_AUTH_MODE=mock

# Firebase Web SDK public client configuration.
EXPO_PUBLIC_FIREBASE_ENABLED=false
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nexora-73cfa
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
