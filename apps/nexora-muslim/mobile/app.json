{
  "expo": {
    "name": "Nexora Muslim",
    "slug": "nexora-muslim",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nexoramuslim",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.nexora.muslim"
    },
    "ios": {
      "bundleIdentifier": "com.nexora.muslim"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
