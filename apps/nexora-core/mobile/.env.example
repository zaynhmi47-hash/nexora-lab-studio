# Nexora Core API
# For a physical Android device, replace localhost with your development machine's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Firebase Web SDK public client configuration.
# These values are client configuration, not service-account credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nexora-73cfa
EXPO_PUBLIC_FIREBASE_APP_ID=

# Native Firebase builds also require google-services.json (Android)
# and GoogleService-Info.plist (iOS), supplied securely during the native build.
