# Nexora Core API origin, without /api/v1.
EXPO_PUBLIC_NEXORA_API_URL=

# Firebase client configuration for the Nexora identity project.
# These are public client identifiers; never put service-account credentials here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
