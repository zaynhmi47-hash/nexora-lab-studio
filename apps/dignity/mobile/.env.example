# Public Firebase client configuration only. Never put service-account/private keys in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_NEXORA_API_URL=http://localhost:8000
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nexora-73cfa
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# For a physical Android device, localhost points to the device itself.
# Replace the API URL with a reachable LAN address or HTTPS development tunnel.
